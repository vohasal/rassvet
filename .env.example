# Copy to .env. Node.js 24+ required. Local demo only by default.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/rassvet.sqlite
DEMO_MODE=true
# Local presentation credential. Replace before sharing access.
ADMIN_PASSWORD=rassvet-demo
# Optional real Telegram authentication and contact sharing (long polling).
TELEGRAM_BOT_TOKEN=
# Staff group chat ID. Add the bot to that group to receive order notifications.
STAFF_CHAT_ID=
# HTTPS URL of the mini app, once hosting is available.
MINI_APP_URL=
# Browser key, restricted to your domains; enable JavaScript API + geocoder.
YANDEX_MAPS_API_KEY=
# Real Click/Payme/Yandex Delivery adapters are not enabled in this demo.
# Cashier terminal credentials do not enable online merchant APIs.
